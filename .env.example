# tsov LLM configuration — copy to .env (never committed) and fill in:
#   cp .env.example .env
#
# Your LLM key. Required for the agent (chat) features.
# Default endpoint is DeepSeek official; any OpenAI-compatible API works.
TSOV_LLM_API_KEY=
#
# Optional: custom endpoint (must expose /v1/chat/completions)
# TSOV_LLM_ENDPOINT=https://api.deepseek.com/v1/chat/completions
#
# Optional: model name (default: deepseek-v4-flash)
# TSOV_LLM_MODEL=deepseek-v4-flash
