+def _log_device_report(trainer) -> None:
+    """Print the resolved Lightning device and, on CUDA, the peak VRAM used."""
+    try:
+        device = "unknown"
+        if trainer is not None:
+            # Lightning 2.x: Trainer has no .device; the strategy owns root_device.
+            device = str(getattr(getattr(trainer, "strategy", None), "root_device", "unknown"))
+        logging.info(
+            f"[GAME-DEVICE] resolved_root_device={device} "
+            f"cuda_available={torch.cuda.is_available()}",
+            callback=rank_zero_info,
+        )
+        if torch.cuda.is_available():
+            logging.info(
+                f"[GAME-DEVICE] cuda_max_memory_allocated="
+                f"{torch.cuda.max_memory_allocated() / 1024 ** 2:.1f}MiB "
+                f"cuda_max_memory_reserved="
+                f"{torch.cuda.max_memory_reserved() / 1024 ** 2:.1f}MiB",
+                callback=rank_zero_info,
+            )
+    except Exception as e:  # never fail the run because of diagnostics
+        logging.warning(f"[GAME-DEVICE] device report failed: {e}")
